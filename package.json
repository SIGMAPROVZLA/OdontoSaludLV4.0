{
  "name": "odontosalud-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Odontológica Multisede La Victoria & Colonia Tovar con VictorIA Pro",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "wrangler dev src/server/index.ts --port 8787",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 execute DB --local --file=migrations/0001_initial_schema.sql",
    "db:seed:local": "wrangler d1 execute DB --local --file=migrations/0002_seed_clinical_data.sql"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "hono": "^4.6.14",
    "lucide-react": "^0.474.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wrangler": "^3.101.0"
  }
}
